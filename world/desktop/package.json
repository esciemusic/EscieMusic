{
  "name": "escie-world",
  "version": "0.1.0",
  "private": true,
  "description": "ESCIE World desktop shell for the downloadable game.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "stage": "node stage.cjs",
    "package:win": "npm run stage && electron-builder --win",
    "package:mac": "npm run stage && electron-builder --mac",
    "package:linux": "npm run stage && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.escie.world",
    "productName": "ESCIE World",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "asar": true
  },
  "dependencies": {
    "three": "0.160.0"
  }
}
