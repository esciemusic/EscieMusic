/* ==========================================
   ESCIE // COMMAND HUB - CORE STYLESHEET
   ========================================== */

:root {
    --bg-obsidian: #060608;
    --panel-bg: rgba(12, 12, 18, 0.85);
    --border-obsidian: #1e1e2d;
    --neon-blue: #00b4d8;
    --neon-crimson: #e63946;
    --ghost-white: #f1f5f9;
    --text-muted: #94a3b8;
    --font-mono: 'JetBrains Mono', monospace;
    --font-sans: 'Inter', sans-serif;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: var(--bg-obsidian);
    color: var(--ghost-white);
    font-family: var(--font-sans);
    height: 100vh;
    overflow: hidden;
    position: relative;
}

/* --- ATMOSPHERIC OVERLAYS --- */
.scanline-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: linear-gradient(
        to bottom,
        rgba(255,255,255,0),
        rgba(255,255,255,0) 50%,
        rgba(0, 0, 0, 0.3) 50%,
        rgba(0, 0, 0, 0.3)
    );
    background-size: 100% 4px;
    z-index: 999;
    pointer-events: none;
    opacity: 0.4;
}

.vignette-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    box-shadow: inset 0 0 100px rgba(0, 0, 0, 0.9), inset 0 0 200px rgba(0,0,0,0.8);
    z-index: 998;
    pointer-events: none;
}

/* --- TOP NAVIGATION BAR --- */
.top-nav-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 65px;
    background: var(--panel-bg);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-obsidian);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 2rem;
    z-index: 100;
}

.nav-brand {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 2px;
    color: var(--ghost-white);
}

.brand-tag {
    color: var(--neon-blue);
}

.nav-links {
    display: flex;
    gap: 0.5rem;
}

.nav-btn {
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
    letter-spacing: 1px;
}

.nav-btn:hover {
    color: var(--ghost-white);
    border-color: var(--border-obsidian);
    background: rgba(255, 255, 255, 0.02);
}

.nav-btn.active {
    color: var(--ghost-white);
    border-color: var(--neon-blue);
    background: rgba(0, 180, 216, 0.08);
    box-shadow: 0 0 15px rgba(0, 180, 216, 0.2);
}

.nav-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
}

.status-dot {
    width: 8px;
    height: 8px;
    background-color: var(--neon-blue);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--neon-blue);
    animation: pulse-glow 2s infinite;
}

@keyframes pulse-glow {
    0% { opacity: 0.4; }
    50% { opacity: 1; box-shadow: 0 0 12px var(--neon-blue); }
    100% { opacity: 0.4; }
}

/* --- CENTRAL FLOATING WINDOW WORKSPACE --- */
.workspace-container {
    position: absolute;
    top: 80px;
    left: 2rem;
    right: 2rem;
    bottom: 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
}

.floating-window {
    width: 100%;
    max-width: 1200px;
    height: 100%;
    max-height: 820px;
    background: var(--panel-bg);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-obsidian);
    box-shadow: 0 20px 50px rgba(0,0,0,0.8), inset 0 0 30px rgba(0,0,0,0.5);
    border-radius: 4px;
    padding: 2.5rem;
    overflow-y: auto;
    position: relative;
}

/* Custom Scrollbar for Floating Window */
.floating-window::-webkit-scrollbar {
    width: 6px;
}
.floating-window::-webkit-scrollbar-track {
    background: rgba(0,0,0,0.2);
}
.floating-window::-webkit-scrollbar-thumb {
    background: var(--border-obsidian);
    border-radius: 3px;
}
.floating-window::-webkit-scrollbar-thumb:hover {
    background: var(--neon-blue);
}

/* --- ROOM SECTIONS --- */
.room-section {
    display: none;
    animation: fadeIn 0.3s ease forwards;
}

.room-section.active {
    display: block;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
}

.room-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-obsidian);
    padding-bottom: 1rem;
}

.room-header h2 {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    letter-spacing: 2px;
    color: var(--ghost-white);
}

.room-subtitle {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-top: 0.3rem;
}

/* --- TACTILE BUTTONS --- */
.tactile-btn {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-obsidian);
    color: var(--ghost-white);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.6rem 1.2rem;
    cursor: pointer;
    transition: all 0.2s ease;
    letter-spacing: 1px;
}

.tactile-btn:hover {
    border-color: var(--neon-blue);
    background: rgba(0, 180, 216, 0.1);
    box-shadow: 0 0 10px rgba(0, 180, 216, 0.2);
}

.mono-label {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
}

/* --- ROOM 1: VAULT --- */
.vault-grid-layout {
    display: grid;
    grid-template-columns: 350px 1fr;
    gap: 2.5rem;
    align-items: start;
}

.vault-carousel-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.artwork-display-frame {
    width: 100%;
    aspect-ratio: 1;
    background: #040406;
    border: 1px solid var(--border-obsidian);
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
}

.artwork-placeholder {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--neon-blue);
    letter-spacing: 2px;
    text-align: center;
    padding: 1rem;
}

.carousel-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.vault-tracklist-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.category-switchers {
    display: flex;
    gap: 0.5rem;
}

.cat-btn {
    background: transparent;
    border: 1px solid var(--border-obsidian);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.4rem 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
}

.cat-btn.active, .cat-btn:hover {
    border-color: var(--neon-crimson);
    color: var(--ghost-white);
    background: rgba(230, 57, 70, 0.1);
}

.tracklist-container {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: 420px;
    overflow-y: auto;
}

.track-item-card {
    background: rgba(255, 255, 255, 0.01);
    border: 1px solid var(--border-obsidian);
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    transition: all 0.2s;
}

.track-item-card:hover {
    border-color: var(--neon-blue);
    background: rgba(0, 180, 216, 0.04);
}

.track-info h4 {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ghost-white);
    margin-bottom: 0.2rem;
}

.track-info p {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
}

/* --- ROOM 2: VISUALS --- */
.hero-video-stage {
    width: 100%;
    aspect-ratio: 16/9;
    background: #020204;
    border: 1px solid var(--border-obsidian);
    margin-bottom: 2rem;
    overflow: hidden;
}

.masonry-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
}

.gallery-card {
    background: rgba(255,255,255,0.01);
    border: 1px solid var(--border-obsidian);
    aspect-ratio: 16/9;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition: all 0.2s;
}

.gallery-card:hover {
    border-color: var(--neon-crimson);
    box-shadow: 0 0 15px rgba(230, 57, 70, 0.2);
}

/* --- ROOM 3: EPK --- */
.epk-dossier-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
}

.dossier-card {
    background: rgba(255,255,255,0.01);
    border: 1px solid var(--border-obsidian);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
}

.dossier-card.tech-card {
    grid-column: span 2;
}

.dossier-card h3 {
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 1px;
    color: var(--neon-blue);
}

.bio-tabs {
    display: flex;
    gap: 0.5rem;
}

.bio-tab {
    background: transparent;
    border: 1px solid var(--border-obsidian);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.3rem 0.8rem;
    cursor: pointer;
}

.bio-tab.active, .bio-tab:hover {
    border-color: var(--neon-blue);
    color: var(--ghost-white);
}

.bio-content-box {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-muted);
    min-height: 120px;
}

.asset-list {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
}

.asset-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    padding-bottom: 0.6rem;
}

.tech-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
}

.tech-actions {
    display: flex;
    gap: 1rem;
}

.primary-trigger {
    border-color: var(--neon-crimson);
    background: rgba(230, 57, 70, 0.1);
}
.primary-trigger:hover {
    background: rgba(230, 57, 70, 0.2);
    border-color: var(--neon-crimson);
}

/* --- ROOM 4: CONTACTS --- */
.contacts-carousel-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 700px;
    margin: 0 auto;
}

.contacts-carousel {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
}

.contact-card {
    background: rgba(255,255,255,0.01);
    border: 1px solid var(--border-obsidian);
    padding: 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    transition: all 0.2s;
}

.contact-card:hover {
    border-color: var(--neon-blue);
}

.contact-card h3 {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    letter-spacing: 2px;
}

/* --- ROOM 5: CHAT BOARD --- */
.chat-terminal-wrapper {
    display: flex;
    flex-direction: column;
    height: 520px;
    background: #040406;
    border: 1px solid var(--border-obsidian);
}

.chat-feed {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.chat-msg {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.4;
    border-left: 2px solid var(--neon-blue);
    padding-left: 0.8rem;
}

.chat-msg .msg-user {
    color: var(--neon-blue);
    font-weight: 700;
    margin-right: 0.5rem;
}

.chat-msg .msg-time {
    color: var(--text-muted);
    font-size: 0.75rem;
    margin-left: 0.5rem;
}

.chat-msg .msg-text {
    color: var(--ghost-white);
    display: block;
    margin-top: 0.2rem;
}

.chat-input-form {
    display: flex;
    border-top: 1px solid var(--border-obsidian);
    background: var(--panel-bg);
}

.chat-input-form input {
    background: transparent;
    border: none;
    color: var(--ghost-white);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 1rem;
    outline: none;
}

#chat-user-handle {
    width: 180px;
    border-right: 1px solid var(--border-obsidian);
    color: var(--neon-blue);
}

#chat-message-text {
    flex: 1;
}

.transmit-btn {
    border: none;
    border-left: 1px solid var(--border-obsidian);
    background: rgba(0, 180, 216, 0.1);
    color: var(--neon-blue);
    font-weight: 700;
    padding: 0 2rem;
    cursor: pointer;
}
.transmit-btn:hover {
    background: rgba(0, 180, 216, 0.2);
}

/* --- ROOM 6: TOOLS --- */
.tools-carousel-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 800px;
    margin: 0 auto;
}

.tools-rack {
    position: relative;
    min-height: 350px;
}

.tool-module {
    display: none;
    background: rgba(255, 255, 255, 0.01);
    border: 1px solid var(--border-obsidian);
    padding: 2.5rem;
    flex-direction: column;
    gap: 1.5rem;
}

.tool-module.active {
    display: flex;
}

.tool-module h3 {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--neon-crimson);
    letter-spacing: 1px;
}

.tool-controls {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
}

.tool-controls input[type="number"] {
    background: #040406;
    border: 1px solid var(--border-obsidian);
    color: var(--ghost-white);
    padding: 0.4rem;
    width: 90px;
    font-family: var(--font-mono);
}

.calc-results {
    background: rgba(0,0,0,0.4);
    border: 1px solid var(--border-obsidian);
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

#lyric-input-box {
    width: 100%;
    height: 140px;
    background: #040406;
    border: 1px solid var(--border-obsidian);
    color: var(--ghost-white);
    font-family: var(--font-mono);
    padding: 1rem;
    resize: none;
    outline: none;
}

.lyric-metrics {
    display: flex;
    gap: 2rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
}

.scale-selector-box {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.scale-selector-box select {
    background: #040406;
    border: 1px solid var(--border-obsidian);
    color: var(--ghost-white);
    padding: 0.6rem;
    font-family: var(--font-mono);
}

.scale-output {
    background: rgba(0,0,0,0.4);
    border: 1px solid var(--border-obsidian);
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--neon-blue);
}

/* --- MOVABLE & COLLAPSIBLE AUDIO CONSOLE --- */
.audio-console-chassis {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 380px;
    background: var(--panel-bg);
    backdrop-filter: blur(16px);
    border: 1px solid var(--neon-crimson);
    box-shadow: 0 10px 30px rgba(0,0,0,0.8), 0 0 20px rgba(230, 57, 70, 0.15);
    z-index: 200;
    border-radius: 3px;
    user-select: none;
}

.console-top-bar {
    background: rgba(230, 57, 70, 0.1);
    border-bottom: 1px solid var(--border-obsidian);
    padding: 0.5rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: grab;
}

.console-top-bar:active {
    cursor: grabbing;
}

.console-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 2px;
    color: var(--neon-crimson);
}

.console-window-controls button {
    background: transparent;
    border: none;
    color: var(--ghost-white);
    font-family: var(--font-mono);
    cursor: pointer;
    font-size: 0.9rem;
}

.console-body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
}

.marquee-viewport {
    background: #020204;
    border: 1px solid var(--border-obsidian);
    padding: 0.6rem;
    overflow: hidden;
    white-space: nowrap;
}

.marquee-track {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ghost-white);
    display: inline-block;
    animation: marquee 18s linear infinite;
}

@keyframes marquee {
    0% { transform: translateX(100%); }
    100% { transform: translateX(-100%); }
}

.console-category-strip {
    display: flex;
    gap: 0.4rem;
}

.console-cat-btn {
    flex: 1;
    background: transparent;
    border: 1px solid var(--border-obsidian);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.3rem;
    cursor: pointer;
    transition: all 0.2s;
}

.console-cat-btn.active, .console-cat-btn:hover {
    border-color: var(--neon-blue);
    color: var(--ghost-white);
    background: rgba(0, 180, 216, 0.1);
}

.console-transport-strip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.console-transport-strip input[type="range"] {
    flex: 1;
    accent-color: var(--neon-crimson);
}

.play-trigger {
    background: rgba(230, 57, 70, 0.15);
    border-color: var(--neon-crimson);
}

/* Collapsed State Class */
.audio-console-chassis.collapsed .console-body {
    display: none;
}
.audio-console-chassis.collapsed {
    width: 260px;
}
